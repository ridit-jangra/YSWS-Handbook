---
import { ArrowUpRight, Plus } from "@lucide/astro";
import Base from "../layouts/Base.astro";
import { site, nav, what, steps, shop, faq } from "../data/shark";

const ticker = [
  "Blåhaj sighted off the coast",
  "1 hour = 1 tooth",
  "Teens 13 to 18 only",
  "Free to enter",
  "Games, sites, apps, hardware",
  "Fins required",
];
---

<Base
  title="You Shark, We Shark · Shark Week"
  theme="theme-3"
  fonts="Anton&family=Archivo:wght@400;600;800&family=JetBrains+Mono:wght@500;700"
>
  <header class="hero">
    <div class="masthead-bar">
      <span>Vol. 1</span>
      <span>A Hack Club You Ship, We Ship</span>
      <span>Free</span>
    </div>

    <nav class="topnav" aria-label="Main">
      <a class="brand" href="#top">YSWS</a>
      <ul>
        {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
      </ul>
      <a class="btn btn-small" href={site.signupUrl}>Sign up</a>
    </nav>

    <div class="headline" id="top">
      <p class="kicker">Breaking · All projects must have fins</p>
      <h1 class="wordmark">
        <span>You shark.</span>
        <span><mark>We shark.</mark></span>
      </h1>
      <div class="deck">
        <p class="punchline">{site.punchline}</p>
        <a class="btn" href={site.signupUrl}>
          Start building <ArrowUpRight size={22} stroke-width={3} aria-hidden="true" />
        </a>
      </div>
    </div>

    <div class="sea" aria-hidden="true">
      <svg class="fin" viewBox="0 0 140 100">
        <path d="M0 100 C40 92 70 44 82 0 C96 40 112 80 140 100 Z" />
      </svg>
      <svg class="swell" viewBox="0 0 1200 40" preserveAspectRatio="none">
        <path d="M0 20 Q50 0 100 20 T200 20 T300 20 T400 20 T500 20 T600 20 T700 20 T800 20 T900 20 T1000 20 T1100 20 T1200 20 V40 H0 Z" />
      </svg>
    </div>

    <div class="ticker" aria-hidden="true">
      <div class="ticker-track">
        {[...ticker, ...ticker].map((t) => <span>{t} ★</span>)}
      </div>
    </div>
  </header>

  <main>
    <section id="what" class="section what">
      <p class="label">Section A · The story</p>
      <h2>{what.title}</h2>
      <div class="columns">
        {what.body.map((p) => <p>{p}</p>)}
      </div>

      <p class="label label-gap">What people are building</p>
      <ol class="ideas">
        {
          what.ideas.map((idea, i) => (
            <li>
              <span class="idea-num">{String(i + 1).padStart(2, "0")}</span>
              <div>
                <h3>
                  {idea.title} <span class="idea-kind">{idea.kind}</span>
                </h3>
                <p>{idea.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section id="how" class="section how">
      <p class="label">Section B · The process</p>
      <h2>How it works</h2>
      <ol class="steps">
        {
          steps.map((s, i) => (
            <li>
              <span class="step-num">{String(i + 1).padStart(2, "0")}</span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section id="shop" class="section shop">
      <p class="label">Section C · Classifieds</p>
      <h2>The Shark Shop</h2>
      <p class="lede">Every approved hour pays 1 tooth. Draft prices, final rates are set with the sponsor.</p>
      <ul class="classifieds">
        {
          shop.map((s) => (
            <li>
              <span class="item">{s.item}</span>
              <span class="cost">{s.teeth} teeth</span>
            </li>
          ))
        }
      </ul>
    </section>

    <section id="faq" class="section faq">
      <p class="label">Section D · Letters to the editor</p>
      <h2>FAQ</h2>
      <div class="faq-list">
        {
          faq.map((f) => (
            <details>
              <summary>
                <span>{f.q}</span>
                <Plus class="faq-icon" size={26} stroke-width={3} aria-hidden="true" />
              </summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </section>
  </main>

  <section id="signup" class="signup">
    <h2>Get in the water.</h2>
    <div class="signup-actions">
      <a class="btn btn-invert" href={site.signupUrl}>
        Start building <ArrowUpRight size={22} stroke-width={3} aria-hidden="true" />
      </a>
      <a class="text-link" href={site.slackUrl}>Questions? Hack Club Slack</a>
    </div>
  </section>

  <footer class="footer">
    <p>You Shark, We Shark · a <a href={site.hackClubUrl}>Hack Club</a> You Ship, We Ship program</p>
  </footer>
</Base>

<style>
  .hero {
    border-bottom: 3px solid var(--border);
  }

  .masthead-bar {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.4rem 1rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--bg);
    background: var(--text);
  }

  .topnav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 2rem;
    max-width: 1240px;
    margin: 0 auto;
    padding: 1rem;
    border-bottom: 3px solid var(--border);
  }

  .brand {
    font-family: var(--font-display);
    font-size: 2rem;
    line-height: 1;
    text-decoration: none;
  }

  .topnav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    margin: 0 auto 0 0;
    padding: 0;
    list-style: none;
    font-weight: 800;
    text-transform: uppercase;
    font-size: 0.9rem;
  }

  .topnav ul a {
    text-decoration: none;
  }

  .topnav ul a:hover {
    text-decoration: underline;
    text-decoration-thickness: 3px;
    text-underline-offset: 4px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.85rem 1.4rem;
    font-weight: 800;
    font-size: 1.1rem;
    text-transform: uppercase;
    color: var(--on-accent);
    background: var(--accent);
    border: 3px solid var(--border);
    box-shadow: 6px 6px 0 var(--shadow);
    text-decoration: none;
    transition: transform 0.1s, box-shadow 0.1s;
  }

  .btn:hover {
    transform: translate(-2px, -2px);
    box-shadow: 8px 8px 0 var(--shadow);
  }

  .btn:active {
    transform: translate(6px, 6px);
    box-shadow: 0 0 0 var(--shadow);
  }

  .btn-small {
    padding: 0.45rem 0.9rem;
    font-size: 0.9rem;
    box-shadow: 3px 3px 0 var(--shadow);
  }

  .headline {
    max-width: 1240px;
    margin: 0 auto;
    padding: clamp(2rem, 5vw, 3.5rem) 1rem 2rem;
  }

  .kicker {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    display: inline-block;
    padding: 0.2rem 0.5rem;
    color: var(--on-accent);
    background: var(--accent);
  }

  .wordmark {
    margin-top: 1rem;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(3.6rem, 15vw, 12rem);
    line-height: 0.88;
    text-transform: uppercase;
    letter-spacing: -0.01em;
  }

  .wordmark span {
    display: block;
  }

  mark {
    display: inline-block;
    margin-top: 0.06em;
    padding: 0.06em 0.1em 0;
    line-height: 0.9;
    color: var(--on-accent-2);
    background: var(--accent-2);
  }

  .deck {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 3px solid var(--border);
  }

  .punchline {
    max-width: 32rem;
    font-size: clamp(1.15rem, 2.4vw, 1.5rem);
    font-weight: 600;
    line-height: 1.35;
  }

  .sea {
    position: relative;
    height: 120px;
    background: var(--sea);
    overflow: hidden;
  }

  .fin {
    position: absolute;
    bottom: 24px;
    left: 0;
    width: 110px;
    animation: cruise 12s linear -5s infinite;
  }

  .fin path {
    fill: var(--fin);
  }

  .swell {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 200%;
    max-width: none;
    height: 40px;
    animation: swell 6s linear infinite;
  }

  .swell path {
    fill: var(--sea);
    stroke: var(--on-sea);
    stroke-width: 3;
  }

  @keyframes cruise {
    from { transform: translateX(-120px); }
    to { transform: translateX(100vw); }
  }

  @keyframes swell {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  .ticker {
    overflow: hidden;
    padding: 0.7rem 0;
    background: var(--accent-2);
    border-top: 3px solid var(--border);
  }

  .ticker-track {
    display: flex;
    gap: 2rem;
    width: max-content;
    font-family: var(--font-display);
    font-size: 1.3rem;
    text-transform: uppercase;
    color: var(--on-accent-2);
    animation: ticker 30s linear infinite;
  }

  @keyframes ticker {
    to { transform: translateX(-50%); }
  }

  .section {
    max-width: 1240px;
    margin: 0 auto;
    padding: clamp(3.5rem, 8vw, 6rem) 1rem 0;
  }

  .label {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border);
  }

  .label-gap {
    margin-top: 3.5rem;
  }

  .section h2 {
    margin-top: 1rem;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.6rem, 8vw, 5.5rem);
    line-height: 0.95;
    text-transform: uppercase;
  }

  .columns {
    columns: 2 20rem;
    column-gap: 3rem;
    column-rule: 1px solid var(--border);
    margin-top: 2rem;
    font-size: 1.15rem;
  }

  .columns p + p {
    margin-top: 1rem;
  }

  .columns p:first-child::first-letter {
    float: left;
    margin: 0.05em 0.1em 0 0;
    font-family: var(--font-display);
    font-size: 4.2em;
    line-height: 0.8;
    color: var(--accent);
  }

  .ideas {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ideas li {
    display: flex;
    gap: 1rem;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--border);
  }

  .idea-num {
    font-family: var(--font-display);
    font-size: 2.4rem;
    line-height: 1;
    color: var(--accent);
  }

  .ideas h3 {
    font-size: 1.25rem;
    font-weight: 800;
  }

  .idea-kind {
    margin-left: 0.25rem;
    padding: 0.05rem 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    vertical-align: middle;
    border: 1px solid var(--border);
  }

  .ideas p {
    margin-top: 0.25rem;
    color: var(--muted);
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    margin: 2.5rem 0 0;
    padding: 0;
    list-style: none;
    border-top: 3px solid var(--border);
    border-left: 3px solid var(--border);
  }

  .steps li {
    padding: 1.5rem;
    border-right: 3px solid var(--border);
    border-bottom: 3px solid var(--border);
    background: var(--surface);
  }

  .steps li:nth-child(2) {
    background: var(--accent-2);
    color: var(--on-accent-2);
  }

  .step-num {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(4.5rem, 10vw, 7rem);
    line-height: 0.9;
  }

  .steps li:nth-child(1) .step-num,
  .steps li:nth-child(3) .step-num {
    color: var(--accent);
  }

  .steps h3 {
    margin-top: 0.75rem;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 2.2rem;
    text-transform: uppercase;
  }

  .steps p {
    margin-top: 0.5rem;
  }

  .lede {
    margin-top: 1rem;
    color: var(--muted);
    font-size: 1.1rem;
  }

  .classifieds {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr));
    gap: 0;
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--border);
    border-left: 1px solid var(--border);
  }

  .classifieds li {
    display: grid;
    gap: 0.5rem;
    padding: 1rem;
    border-right: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    background: var(--surface);
  }

  .item {
    font-weight: 800;
    text-transform: uppercase;
  }

  .cost {
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--accent);
  }

  .faq-list {
    max-width: 60rem;
    margin-top: 2rem;
    border-top: 3px solid var(--border);
  }

  details {
    border-bottom: 1px solid var(--border);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem 0;
    font-weight: 800;
    font-size: clamp(1.15rem, 2.4vw, 1.4rem);
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:hover span {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 3px;
    text-underline-offset: 5px;
  }

  .faq-icon {
    flex-shrink: 0;
    transition: transform 0.15s;
  }

  details[open] .faq-icon {
    transform: rotate(45deg);
    color: var(--accent);
  }

  details p {
    max-width: 46rem;
    padding-bottom: 1.5rem;
    font-size: 1.1rem;
  }

  .signup {
    margin-top: clamp(4rem, 9vw, 7rem);
    padding: clamp(3rem, 8vw, 5rem) 1rem;
    color: var(--on-accent);
    background: var(--accent);
    border-top: 3px solid var(--border);
    border-bottom: 3px solid var(--border);
    text-align: center;
  }

  .signup h2 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(3rem, 12vw, 8rem);
    line-height: 0.9;
    text-transform: uppercase;
  }

  .signup-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    margin-top: 2rem;
  }

  .btn-invert {
    color: var(--on-accent-2);
    background: var(--accent-2);
  }

  .text-link {
    font-weight: 800;
  }

  .footer {
    padding: 1.5rem 1rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    text-align: center;
  }

  @media (max-width: 640px) {
    .masthead-bar span:first-child,
    .masthead-bar span:last-child {
      display: none;
    }

    .masthead-bar {
      justify-content: center;
    }

    .topnav ul {
      order: 3;
      width: 100%;
      font-size: 0.8rem;
      gap: 0.25rem 1rem;
    }

    .brand {
      margin-right: auto;
    }
  }
</style>
