    .timecard td { border: 0; padding: 6px 4px; }
    .rig { min-height: 330px; }
    .rig-load { width: 76px; height: 64px; margin-top: -12px; }
    .gear { left: 6px; top: -14px; width: 64px; height: 45px; }
    .hook-plate { font-size: 1rem; padding: 3px 6px; }
    .pull { position: static; margin-top: 10px; }
    .pull-chain { height: 20px; }
    .pull[aria-pressed="true"] .pull-chain { height: 40px; }
    .pull-handle { font-size: .8rem; padding: 2px 4px; }
    .rig-col.is-down .rig-chain { height: 90px; }
    .counter-slip ul { columns: 1; }
    .tokens { grid-template-columns: repeat(4, 1fr); padding: 18px 8px; }
    .token-disc { width: 68px; height: 68px; }
    .token-tag { font-size: .72rem; }
  }
  @media (max-width: 420px) {
    .tokens { grid-template-columns: repeat(3, 1fr); }
  }
</style>

<script>
  import { gsap } from "gsap";

  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const cols = [...document.querySelectorAll<HTMLElement>(".rig-col")];

  function lower(id: string) {
    cols.forEach((col) => {
      const down = col.dataset.hook === id;
      const chain = col.querySelector<HTMLElement>(".rig-chain")!;
      const target = down ? (window.innerWidth <= 860 ? 90 : 150) : 40;
      col.classList.toggle("is-down", down);
      col.querySelector(".pull")!.setAttribute("aria-pressed", String(down));
      if (reduce) chain.style.height = `${target}px`;
      else gsap.to(chain, { height: target, duration: down ? 1.1 : 0.5, ease: down ? "elastic.out(1, 0.45)" : "power2.out" });
    });
    document.querySelectorAll<HTMLElement>("[data-slip]").forEach((slip) => {
      slip.hidden = slip.dataset.slip !== id;
      if (!slip.hidden && !reduce) gsap.from(slip, { y: -30, rotation: -3, opacity: 0, duration: 0.5, ease: "back.out(1.8)" });
    });
  }

  document.querySelectorAll<HTMLButtonElement>(".pull").forEach((btn) => {
    btn.addEventListener("click", () => lower(btn.dataset.hook!));
    // a real tug works too: drag the handle down past 30px
    let startY: number | null = null;
    btn.addEventListener("pointerdown", (e) => { startY = e.clientY; });
    window.addEventListener("pointerup", (e) => {
      if (startY !== null && e.clientY - startY > 30) lower(btn.dataset.hook!);
      startY = null;
    });
  });

  // token board: take a token off, the logbook shows its question
  document.querySelectorAll<HTMLButtonElement>(".token").forEach((tok) => {
    tok.addEventListener("click", () => {
      document.querySelectorAll(".token").forEach((t) => t.setAttribute("aria-pressed", String(t === tok)));
      document.querySelectorAll<HTMLElement>("[data-log]").forEach((log) => { log.hidden = log.dataset.log !== tok.dataset.token; });
    });
  });
</script>
