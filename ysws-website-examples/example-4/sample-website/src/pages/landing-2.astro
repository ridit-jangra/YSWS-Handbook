  .levels { display: flex; gap: 6px; list-style: none; padding: 0; margin: 0 0 16px; flex-wrap: wrap; }
  .levels li { width: 46px; text-align: center; font-family: var(--font-display); font-weight: 700; font-size: .85rem; }
  .levels li span { display: block; width: 26px; height: 26px; margin: 0 auto 2px; border-radius: 50%; border: 2px dashed #a99a6e; line-height: 22px; }
  .levels .coupon-hole span { background: var(--tile); border: 3px solid var(--rust); color: var(--rust); }
  .levels em { font-style: normal; color: var(--rust); display: block; font-size: .75rem; }
  .timecard table { width: 100%; border-collapse: collapse; }
  .timecard th { text-align: left; font-family: var(--font-display); font-size: 1rem; border-bottom: 2px solid var(--text); padding: 4px 8px; }
  .timecard td { border-bottom: 1px solid #c8b98c; padding: 10px 8px; vertical-align: top; }
  .timecard .t { font-family: var(--font-display); font-weight: 700; font-size: 1.15rem; width: 4.2em; }
  .timecard .st { width: 8.5em; text-align: center; }
  .stamp {
    display: inline-block; font-family: var(--font-display); font-weight: 800; color: var(--rust); border: 3px solid var(--rust);
    padding: 0 6px; border-radius: 4px; transform: rotate(-7deg); opacity: .9; letter-spacing: .04em;
  }
  .timecard-foot { margin: 14px 0 0; font-size: .95rem; }

  /* ---------- trip ---------- */
  .trip { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 30px 60px; padding: 40px clamp(16px, 4vw, 40px) 90px; }
  .roadsign {
    background: var(--signal); color: #111; border: 5px solid #111; outline: 4px solid var(--signal);
    font-family: var(--font-display); font-weight: 700; padding: 12px 70px 12px 22px; display: grid;
    clip-path: polygon(0 0, 86% 0, 100% 50%, 86% 100%, 0 100%); min-width: 300px;
  }
  .roadsign-top { font-size: 1.1rem; }
  .roadsign-main { font-size: 3rem; line-height: 1; }
