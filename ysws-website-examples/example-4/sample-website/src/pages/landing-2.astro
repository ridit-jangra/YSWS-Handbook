  .trip-text { max-width: 480px; }
  .trip-text p { margin-bottom: 0; }

  /* ---------- token board FAQ ---------- */
  .board { padding: 80px clamp(16px, 4vw, 40px) 100px; max-width: 1100px; margin: 0 auto; }
