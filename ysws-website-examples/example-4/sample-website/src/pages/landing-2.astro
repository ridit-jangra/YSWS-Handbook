    margin-top: 2px; width: 82px; height: 82px; border-radius: 50%; display: grid; place-content: center; text-align: center;
    background: radial-gradient(circle at 35% 30%, #f3dc8e, #c79a3a 55%, #8e6a22); color: #2e2208;
    box-shadow: inset 0 0 0 3px rgba(0,0,0,.25), 0 3px 0 rgba(0,0,0,.35); font-family: var(--font-display); font-weight: 800;
  }
  .token-no { font-size: 1.5rem; line-height: 1; }
  .token-tag { font-size: .85rem; line-height: 1.05; padding: 0 6px; }
  .token[aria-pressed="true"] { transform: translateY(14px) rotate(-8deg); }
