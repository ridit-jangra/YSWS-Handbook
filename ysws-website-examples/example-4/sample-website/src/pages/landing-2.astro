    border: 4px solid var(--text); margin-top: 40px; font-family: var(--font-display); font-weight: 700; letter-spacing: .05em;
  }
  .clockface { width: 130px; height: 130px; border-radius: 50%; margin: 0 auto; background: #fbf8ef; border: 5px solid var(--text); position: relative; }
  .hand { position: absolute; left: 50%; bottom: 50%; width: 4px; margin-left: -2px; background: var(--text); transform-origin: 50% 100%; border-radius: 2px; }
  .hand--h { height: 34px; transform: rotate(60deg); } .hand--m { height: 52px; transform: rotate(-30deg); }
  .slot { height: 12px; margin: 6px 20px 0; background: var(--text); border-radius: 3px; }
