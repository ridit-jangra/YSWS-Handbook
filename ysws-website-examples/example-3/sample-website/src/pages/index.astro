---
import Base from "../layouts/Base.astro";

const fonts =
  "family=Atkinson+Hyperlegible:wght@400;700&family=Bowlby+One&family=Archivo:wdth,wght@62..125,400..900&family=Spectral:ital,wght@1,700&family=Overpass:wght@400;700";

const concepts = [
  {
    href: "/landing-1",
    theme: "concept-1",
    name: "Alterations",
    world: "A tailor's cutting table. Your site is too big in the shoulders; drag the tape to take it in.",
  },
  {
    href: "/landing-2",
    theme: "concept-2",
    name: "The Repair Counter",
    world: "A mall phone-fix kiosk. Repair ticket, parts wall, and a claim stub you tear off to RSVP.",
  },
  {
    href: "/landing-3",
    theme: "concept-3",
    name: "Thumb Country",
    world: "A topographic map of reach. Your thumb follows the cursor; the nav lives down in the meadows.",
  },
];
---

<Base title="Mobile Friendly: three concepts" description="Three landing page concepts for the Mobile Friendly Hack Club YSWS." fonts={fonts}>
  <main>
    <h1>Mobile Friendly</h1>
    <p class="intro">
      Three landing page concepts for a Hack Club YSWS where you ship a website that works on a phone.
      Open each one on your actual phone too, that's kind of the point.
    </p>
    <ul class="phones">
      {
        concepts.map((c) => (
          <li data-theme={c.theme}>
            <a href={c.href} class="phone">
              <span class="screen">
                <span class="which">{c.href.slice(1)}</span>
                <span class="name">{c.name}</span>
                <span class="world">{c.world}</span>
                <span class="open">Open it</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </main>
</Base>

<style>
  :global(body) {
    background: #ececec;
    color: #161616;
  }
  main {
    max-width: 1080px;
    margin: 0 auto;
    padding: 3rem 1rem 4rem;
  }
  h1 {
    font-family: "Archivo", sans-serif;
    font-stretch: 125%;
    font-weight: 900;
    font-size: clamp(2.4rem, 8vw, 4.5rem);
    margin: 0;
    line-height: 1;
  }
  .intro {
    max-width: 52ch;
    font-size: 1.15rem;
    margin: 0.75rem 0 2.5rem;
  }
  .phones {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 2rem;
  }
  .phones li:nth-child(1) { transform: rotate(-3deg); }
  .phones li:nth-child(2) { transform: translateY(1.5rem); }
  .phones li:nth-child(3) { transform: rotate(3deg); }
  .phone {
    display: block;
    width: min(80vw, 270px);
    aspect-ratio: 9 / 18;
    padding: 12px;
    background: #1b1d22;
    border-radius: 36px;
    text-decoration: none;
    box-shadow: 10px 14px 0 rgba(0, 0, 0, 0.18);
  }
  .phone:hover {
    transform: translateY(-6px);
  }
  .screen {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 0.75rem;
    height: 100%;
    border-radius: 26px;
    padding: 1.5rem 1.25rem;
    background: var(--bg);
    color: var(--on-bg);
    font-family: var(--font-body);
  }
  .which {
    margin-bottom: auto;
    font-weight: 700;
    opacity: 0.8;
  }
  .name {
    font-family: var(--font-display);
    font-size: 1.9rem;
    line-height: 1;
  }
  [data-theme="concept-2"] .name { font-stretch: 125%; font-weight: 900; }
  [data-theme="concept-3"] .name { font-style: italic; font-weight: 700; }
  .world {
    font-size: 1rem;
    line-height: 1.4;
  }
  .open {
    align-self: flex-start;
    background: var(--accent);
    color: var(--on-accent);
    font-weight: 700;
    padding: 0.7rem 1.1rem;
    border-radius: 999px;
  }
</style>
