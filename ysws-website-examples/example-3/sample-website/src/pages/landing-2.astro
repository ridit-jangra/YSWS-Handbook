---
import Base from "../layouts/Base.astro";

const fonts =
  "family=Archivo:wdth,wght@62..125,400..900&family=Courier+Prime:wght@400;700&family=Permanent+Marker";

const ticketLines = [
  { code: "01", item: "Drop-off", note: "Bring any site you made. Old YSWS project, portfolio, that one game. It has to be live." },
  { code: "02", item: "Diagnosis", note: "Open it on your real phone. Write down every crack: pinch-zoom text, tiny buttons, sideways scroll." },
  { code: "03", item: "Repair", note: "Fix it. Stack the layout, 44px taps, 16px text, nav your thumb can reach. Hackatime logs the hours." },
  { code: "04", item: "Bench test", note: "Screen-record 30 seconds of you using it on the phone. Scroll, tap, rotate. No emulator." },
  { code: "05", item: "Pickup", note: "Submit URL + repo + recording. A reviewer tests it on their own phone, then we ship your parts." },
];

const wall = [
  { name: "Phone case", tag: "your model", kind: "case" },
  { name: "USB-C cable", tag: "braided", kind: "cable" },
  { name: "Fast charger", tag: "20W+", kind: "brick" },
  { name: "Power bank", tag: "10,000 mAh", kind: "bank" },
];

const notes = [
  { q: "who can bring a site in?", a: "Anyone 13 to 18. Zero CSS experience is fine, you'll learn it on the bench." },
  { q: "my site's already done. does fixing it count?", a: "That's literally the job. Repairs count. Brand new sites count too." },
  { q: "what's 'mobile friendly' exactly?", a: "At 360px wide: no sideways scroll, no pinch-zoom to read, 44px tap targets, thumb-reachable nav, works rotated." },
  { q: "frameworks? AI?", a: "Any stack. AI can help, but the hours have to be you, and the reviewer will ask what you changed." },
  { q: "what do i actually get?", a: "Cases, chargers, cables, power banks. Big ships can go for a phone grant. Tiers lock in once we have a sponsor." },
  { q: "is this legit?", a: "It's a Hack Club YSWS draft. RSVPs are how we show a sponsor people want it." },
];
---

<Base
  title="Mobile Friendly: The Repair Counter"
  description="A Hack Club YSWS. Bring in a website that breaks on phones, fix it, and pick up phone accessories."
  theme="concept-2"
  fonts={fonts}
>
  <header class="sign">
    <div class="sign-box">
      <p class="sign-hc">Hack Club authorized</p>
      <p class="sign-name">Mobile Friendly</p>
      <p class="sign-sub">website screen repair &amp; accessories</p>
    </div>
    <nav class="sign-nav" aria-label="Sections">
      <a href="#intake"><span class="long">What is this</span><span class="short">What</span></a>
      <a href="#ticket"><span class="long">How it works</span><span class="short">How</span></a>
      <a href="#wall"><span class="long">Parts wall</span><span class="short">Parts</span></a>
      <a href="#notes">FAQ</a>
    </nav>
  </header>

  <main>
    <section class="bench" aria-labelledby="hero-line">
      <div class="tape-strip">
        <h1 id="hero-line">We fix websites that break on phones. You do the fixing. We pay in cases and chargers.</h1>
      </div>

      <figure class="phone-wrap" aria-label="A phone on the repair mat with a cracked screen showing a squished desktop website">
        <!-- ARTIST: replace with an illustrated top-down repair bench: opened phone, spudger,
             suction cup, a magnetic screw tray, all slightly messy. Keep the cracked screen. -->
        <svg class="phone" viewBox="0 0 260 520" aria-hidden="true">
          <rect x="6" y="6" width="248" height="508" rx="38" fill="#1b1d22" stroke="#0a0a0a" stroke-width="4" />
          <rect x="20" y="22" width="220" height="476" rx="26" fill="#f4f6f8" />
          <rect x="98" y="30" width="64" height="16" rx="8" fill="#1b1d22" />
          <!-- the squished desktop site -->
          <g fill="#161616">
            <rect x="34" y="62" width="40" height="5" />
            <rect x="140" y="62" width="14" height="3" /><rect x="158" y="62" width="14" height="3" />
            <rect x="176" y="62" width="14" height="3" /><rect x="194" y="62" width="14" height="3" />
            <rect x="212" y="62" width="14" height="3" />
            <rect x="34" y="82" width="110" height="9" /><rect x="34" y="96" width="80" height="9" />
            <rect x="34" y="112" width="110" height="3" fill="#777" /><rect x="34" y="118" width="96" height="3" fill="#777" />
            <rect x="34" y="128" width="26" height="7" fill="#1d4e9e" />
            <rect x="152" y="80" width="74" height="56" fill="#f59ab8" />
            <rect x="34" y="148" width="58" height="40" fill="none" stroke="#161616" />
            <rect x="100" y="148" width="58" height="40" fill="none" stroke="#161616" />
            <rect x="166" y="148" width="60" height="40" fill="none" stroke="#161616" />
          </g>
          <rect x="20" y="200" width="220" height="298" fill="#e3e6ea" />
          <text x="130" y="236" text-anchor="middle" font-family="Courier Prime, monospace" font-size="13" fill="#4d4d4d">(the rest of the page</text>
          <text x="130" y="254" text-anchor="middle" font-family="Courier Prime, monospace" font-size="13" fill="#4d4d4d">is off to the right)</text>
          <!-- crack -->
          <g fill="none" stroke="#161616" stroke-width="2" stroke-linecap="round" opacity="0.85">
            <path d="M168 300 L240 252 M168 300 L232 380 M168 300 L118 498 M168 300 L40 262 M168 300 L102 190 M168 300 L210 498 M168 300 L240 318" />
            <path d="M200 280 L214 300 L236 296 M190 340 L170 360 M140 380 L120 360 M110 280 L96 300 M130 232 L150 220" stroke-width="1.5" />
            <circle cx="168" cy="300" r="10" fill="#ffffff" fill-opacity="0.6" />
          </g>
        </svg>
        <figcaption class="work-order">
          <span>Work order #0001</span>
          <span>Device: your website</span>
          <span>Complaint: “only works in desktop mode”</span>
        </figcaption>
      </figure>

      <!-- Take-a-number dispenser is the CTA. -->
      <a class="dispenser" href="#ticket">
        <span class="disp-body">
          <span class="disp-now">now serving</span>
          <span class="disp-num">042</span>
        </span>
        <span class="disp-ticket">Take a number: RSVP</span>
      </a>

      <svg class="tools" viewBox="0 0 1100 520" aria-hidden="true" preserveAspectRatio="xMidYMid meet">
        <!-- spudger -->
        <g transform="rotate(-24 180 120)">
          <rect x="60" y="108" width="250" height="20" rx="10" fill="#6b3fa0" stroke="#0f1013" stroke-width="3" />
          <path d="M310 108 L350 118 L310 128 Z" fill="#6b3fa0" stroke="#0f1013" stroke-width="3" />
        </g>
        <!-- suction cup -->
        <g transform="translate(900 90)">
          <circle r="56" fill="#3aa0d8" fill-opacity="0.75" stroke="#0f1013" stroke-width="3" />
          <circle r="30" fill="#2a86bb" stroke="#0f1013" stroke-width="3" />
          <rect x="-8" y="-110" width="16" height="80" rx="6" fill="#d81e3f" stroke="#0f1013" stroke-width="3" />
          <circle cy="-112" r="16" fill="#d81e3f" stroke="#0f1013" stroke-width="3" />
        </g>
        <!-- screwdriver -->
        <g transform="translate(-760 30) rotate(-12 930 420)">
          <rect x="820" y="404" width="120" height="34" rx="12" fill="#ffd23f" stroke="#0f1013" stroke-width="3" />
          <path d="M836 410 V432 M856 410 V432 M876 410 V432 M896 410 V432" stroke="#0f1013" stroke-width="2" />
          <rect x="940" y="414" width="120" height="12" fill="#a7b0ba" stroke="#0f1013" stroke-width="3" />
        </g>
        <!-- loose screws -->
        <g fill="#d7dce1" stroke="#0f1013" stroke-width="2">
          <circle cx="250" cy="380" r="7" /><circle cx="286" cy="404" r="7" /><circle cx="760" cy="200" r="7" />
        </g>
      </svg>

      <ul class="tray" aria-hidden="true">
        <li></li><li></li><li></li><li></li><li></li><li></li>
      </ul>
    </section>

    <section id="intake" class="clipboard" aria-labelledby="intake-title">
      <div class="clip" aria-hidden="true"></div>
      <h2 id="intake-title">Intake form</h2>
      <dl class="form-rows">
        <div><dt>Customer</dt><dd class="filled">a teen with a cool site</dd></div>
        <div><dt>Device</dt><dd class="filled">website, built on a laptop</dd></div>
      </dl>
      <fieldset class="checks">
        <legend>Problem reported</legend>
        <p><span class="box checked" aria-hidden="true"></span>have to turn on desktop mode to see it</p>
        <p><span class="box checked" aria-hidden="true"></span>text is so small I pinch-zoom everything</p>
        <p><span class="box checked" aria-hidden="true"></span>page slides sideways when I scroll</p>
        <p><span class="box checked" aria-hidden="true"></span>menu button is somewhere up in the corner, probably</p>
        <p><span class="box" aria-hidden="true"></span>works great on my phone <span class="lol">(nobody ticks this)</span></p>
      </fieldset>
      <div class="tech-notes">
        <h3>Tech's notes</h3>
        <p>
          Mobile Friendly is a Hack Club You Ship, We Ship for websites that actually work on a phone. Most
          YSWS sites are built on a laptop and tested on a laptop, so on a phone you get desktop mode and
          thumb cramps.
        </p>
        <p>
          You ship a site, new or one you're fixing, that works great at phone size. We ship you phone
          accessories: cases, chargers, power banks. Big ships can get a phone grant.
        </p>
      </div>
    </section>

    <section id="ticket" class="ticket-wrap" aria-labelledby="ticket-title">
      <div class="ticket">
        <p class="t-head">Mobile Friendly Repair</p>
        <p class="t-sub">counter #mobile-friendly · Hack Club Slack</p>
        <h2 id="ticket-title" class="t-title">Repair ticket: how it works</h2>
        <ol class="t-lines">
          {
            ticketLines.map((l) => (
              <li>
                <span class="t-code">{l.code}</span>
                <span class="t-item">{l.item}</span>
                <span class="t-note">{l.note}</span>
              </li>
            ))
          }
        </ol>
        <dl class="t-total">
          <div><dt>Parts</dt><dd>$0.00</dd></div>
          <div><dt>Labor</dt><dd>you</dd></div>
          <div><dt>Paid in</dt><dd>phone stuff</dd></div>
        </dl>
        <div class="barcode" aria-hidden="true"></div>
      </div>

      <!-- Signature moment: drag the claim stub down to tear it off. -->
      <div class="stub-slot">
        <div class="revealed" aria-live="polite" inert>
          <p class="rev-big">You're in the queue.</p>
          <p>Keep the stub. When fittings open we'll ping you in Slack.</p>
          <a class="rsvp" href="https://forms.hackclub.com/mobile-friendly">Fill the RSVP form</a>
        </div>
        <button class="stub" type="button">
          <span class="stub-label">Claim stub</span>
          <span class="stub-num">042</span>
          <span class="stub-hint">Pull down to tear off and RSVP</span>
        </button>
      </div>
    </section>

    <section id="wall" class="wall" aria-labelledby="wall-title">
      <h2 id="wall-title">Parts wall</h2>
      <p class="wall-sub">What we ship back. Bigger repair, more off the wall.</p>
      <div class="pegboard">
        <div class="shelf">
          <div class="grant">
            <p class="grant-small">top shelf, ask at the counter</p>
            <p class="grant-big">Phone grant</p>
            <p class="grant-body">For ships that go way past one site.</p>
          </div>
        </div>
        <ul class="hooks">
          {
            wall.map((w, i) => (
              <li class="hang" style={`--d:${i * 0.15}s`}>
                <span class="hook" aria-hidden="true" />
                <span class="blister">
                  <span class="blister-head" aria-hidden="true" />
                  <svg viewBox="0 0 100 100" class="part" aria-hidden="true">
                    {w.kind === "case" && (
                      <g stroke="#161616" stroke-width="3">
                        <rect x="28" y="8" width="44" height="84" rx="10" fill="#f59ab8" />
                        <rect x="34" y="14" width="16" height="20" rx="5" fill="#161616" />
                      </g>
                    )}
                    {w.kind === "cable" && (
                      <g stroke="#161616" stroke-width="3" fill="none">
                        <path d="M30 18 C10 40 90 40 70 62 C50 84 20 70 34 90" stroke-width="5" stroke="#1d4e9e" />
                        <rect x="24" y="8" width="14" height="14" rx="3" fill="#a7b0ba" />
                        <rect x="28" y="86" width="12" height="10" rx="3" fill="#a7b0ba" />
                      </g>
                    )}
                    {w.kind === "brick" && (
                      <g stroke="#161616" stroke-width="3">
                        <rect x="24" y="26" width="52" height="56" rx="8" fill="#ffffff" />
                        <path d="M40 26 V12 M60 26 V12" />
                        <path d="M54 40 L44 56 H56 L46 72" fill="none" stroke="#1d4e9e" />
                      </g>
                    )}
                    {w.kind === "bank" && (
                      <g stroke="#161616" stroke-width="3">
                        <rect x="14" y="30" width="72" height="42" rx="8" fill="#ffd23f" />
                        <circle cx="30" cy="51" r="4" fill="#161616" />
                        <circle cx="42" cy="51" r="4" fill="#161616" />
                        <circle cx="54" cy="51" r="4" fill="#ffffff" />
                      </g>
                    )}
                  </svg>
                  <span class="part-name">{w.name}</span>
                  <span class="part-tag">{w.tag}</span>
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section id="notes" class="counter" aria-labelledby="notes-title">
      <h2 id="notes-title">Notes stuck to the counter</h2>
      <p class="counter-sub">Stuff people ask at the kiosk, answered in whatever pen was nearby.</p>
      <ul class="stickies">
        {
          notes.map((n) => (
            <li class="sticky">
              <p class="s-q">{n.q}</p>
              <p class="s-a">{n.a}</p>
            </li>
          ))
        }
      </ul>
    </section>
  </main>

  <footer class="foot">
    <p>Mobile Friendly is a Hack Club YSWS draft. Questions go to #mobile-friendly on the Hack Club Slack.</p>
  </footer>
</Base>

<script>
  const stub = document.querySelector<HTMLButtonElement>(".stub")!;
  const slot = document.querySelector<HTMLElement>(".stub-slot")!;
  const TEAR = 90;
  let startY = 0;
  let pulled = 0;
  let dragging = false;
  let moved = false;

  function tear() {
    slot.classList.add("torn");
    slot.querySelector(".revealed")!.removeAttribute("inert");
    stub.style.transform = "";
    stub.setAttribute("aria-hidden", "true");
    stub.tabIndex = -1;
    slot.querySelector<HTMLAnchorElement>(".rsvp")?.focus({ preventScroll: true });
    // Once it has fallen, take it out of layout so it can't cause sideways scroll.
    stub.addEventListener("animationend", () => (stub.hidden = true), { once: true });
  }

  stub.addEventListener("pointerdown", (e) => {
    dragging = true;
    moved = false;
    startY = e.clientY;
    stub.setPointerCapture(e.pointerId);
    stub.classList.add("pulling");
  });
  stub.addEventListener("pointermove", (e) => {
    if (!dragging) return;
    pulled = Math.max(0, e.clientY - startY);
    if (pulled > 4) moved = true;
    // The perforation gives on one side first, so the stub swings as it comes away.
    stub.style.transform = `translateY(${Math.min(pulled, 140) * 0.6}px) rotate(${Math.min(pulled, 140) * 0.06}deg)`;
    if (pulled > TEAR) {
      dragging = false;
      tear();
    }
  });
  const release = () => {
    if (!dragging) return;
    dragging = false;
    stub.classList.remove("pulling");
    stub.style.transform = "";
  };
  stub.addEventListener("pointerup", release);
  stub.addEventListener("pointercancel", release);
  // A plain tap or Enter/Space also tears it, so nobody is locked out.
  stub.addEventListener("click", () => {
    if (!moved && !slot.classList.contains("torn")) tear();
  });
</script>

<style>
  :global(body) {
    background-color: var(--bg);
    background-image:
      linear-gradient(var(--mat-line) 2px, transparent 2px),
      linear-gradient(90deg, var(--mat-line) 2px, transparent 2px);
    background-size: 40px 40px;
    font-size: 1.0625rem;
  }
  h1,
  h2,
  h3 {
    font-family: var(--font-display);
    font-stretch: 125%;
    line-height: 1;
    margin: 0;
  }

  /* ---------- lightbox sign ---------- */
  .sign {
    background: #26282d;
    padding: 0.9rem 1rem 0;
    border-bottom: 6px solid #0f1013;
    text-align: center;
  }
  .sign-box {
    display: inline-block;
    background: #fff;
    color: var(--ink);
    padding: 0.6rem clamp(1rem, 4vw, 3rem) 0.7rem;
    border: 4px solid #0f1013;
    box-shadow:
      0 0 0 4px #a7b0ba,
      0 0 40px rgba(255, 255, 255, 0.35);
    max-width: 100%;
  }
  .sign-hc {
    margin: 0;
    font-family: var(--font-hand);
    font-weight: 700;
    font-size: 0.9rem;
    color: #b0103e;
  }
  .sign-name {
    margin: 0;
    font-family: var(--font-display);
    font-stretch: 125%;
    font-weight: 900;
    font-size: clamp(2.1rem, 8vw, 4.4rem);
    line-height: 0.95;
    color: #d6195a;
    letter-spacing: -0.01em;
  }
  .sign-sub {
    margin: 0.2rem 0 0;
    font-stretch: 100%;
    font-weight: 600;
  }
  .sign-nav {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0 0.4rem;
    margin-top: 0.8rem;
  }
  .sign-nav a {
    color: #fff;
    text-decoration: none;
    font-weight: 700;
    padding: 0.7rem 0.8rem;
    min-height: 44px;
    border-radius: 6px 6px 0 0;
  }
  .sign-nav a:hover {
    background: var(--accent);
    color: var(--on-accent);
  }

  main {
    padding: 0 1rem;
  }

  /* ---------- bench (hero) ---------- */
  .bench {
    position: relative;
    max-width: 1100px;
    margin: 0 auto;
    padding: 1.75rem 0 3rem;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    grid-template-areas:
      "tape tape tape"
      "tray phone disp";
    align-items: center;
    gap: 1.5rem 2rem;
  }
  .tools {
    position: absolute;
    inset: 4rem 0 0;
    width: 100%;
    height: calc(100% - 4rem);
    pointer-events: none;
    z-index: 0;
    filter: drop-shadow(6px 8px 0 rgba(0, 0, 0, 0.3));
  }
  .tape-strip,
  .phone-wrap,
  .dispenser,
  .tray {
    position: relative;
    z-index: 1;
  }
  .tape-strip {
    grid-area: tape;
    justify-self: center;
    max-width: 42rem;
    background: rgba(255, 244, 214, 0.94);
    color: var(--ink);
    padding: 0.9rem 1.4rem;
    transform: rotate(-1.5deg);
    box-shadow: 0 2px 0 rgba(0, 0, 0, 0.2);
    clip-path: polygon(1% 4%, 99% 0, 100% 93%, 0 100%);
  }
  .tape-strip h1 {
    font-stretch: 100%;
    font-weight: 800;
    font-size: clamp(1.4rem, 3.6vw, 2.2rem);
    line-height: 1.1;
  }
  .phone-wrap {
    grid-area: phone;
    margin: 0;
    display: grid;
    justify-items: center;
    gap: 1rem;
  }
  .phone {
    width: clamp(200px, 22vw, 290px);
    transform: rotate(-9deg);
    filter: drop-shadow(14px 18px 0 rgba(0, 0, 0, 0.35));
  }
  .work-order {
    display: grid;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--font-hand);
    font-size: 0.95rem;
    padding: 0.6rem 0.9rem;
    transform: rotate(2deg);
    border-left: 8px solid var(--accent);
  }
  .dispenser {
    grid-area: disp;
    justify-self: start;
    display: grid;
    justify-items: center;
    text-decoration: none;
    color: var(--ink);
  }
  .disp-body {
    display: grid;
    justify-items: center;
    background: #d81e3f;
    color: #fff;
    border: 4px solid #0f1013;
    border-radius: 60px 60px 16px 16px;
    padding: clamp(1.2rem, 3vw, 2rem) clamp(1.4rem, 3vw, 2.4rem) 1.2rem;
    box-shadow: 8px 10px 0 rgba(0, 0, 0, 0.35);
  }
  .disp-now {
    font-family: var(--font-hand);
    font-size: 0.85rem;
  }
  .disp-num {
    font-family: var(--font-hand);
    font-weight: 700;
    font-size: clamp(2.6rem, 5vw, 3.6rem);
    line-height: 1;
    background: #0f1013;
    color: #ff5a5f;
    padding: 0.2rem 0.6rem;
    border-radius: 6px;
    margin-top: 0.3rem;
  }
  .disp-ticket {
    background: var(--paper);
    border: 2px solid #0f1013;
    padding: 0.9rem 1.3rem;
    font-weight: 800;
    font-size: 1.2rem;
    margin-top: -2px;
    transform-origin: top center;
    transform: rotate(-4deg);
    transition: transform 0.2s;
    min-height: 44px;
  }
  .dispenser:hover .disp-ticket,
  .dispenser:focus-visible .disp-ticket {
    transform: rotate(3deg) translateY(4px);
  }
  .tray {
    grid-area: tray;
    justify-self: end;
    list-style: none;
    margin: 0;
    padding: 10px;
    display: grid;
    grid-template-columns: repeat(3, 46px);
    gap: 8px;
    background: #12346b;
    border-radius: 10px;
    transform: rotate(5deg);
  }
  .tray li {
    height: 46px;
    border-radius: 6px;
    background:
      radial-gradient(circle, #d7dce1 0 3px, #6e7781 3px 5px, transparent 5px) 30% 40% / 100% 100% no-repeat,
      radial-gradient(circle, #d7dce1 0 3px, #6e7781 3px 5px, transparent 5px) 70% 65% / 100% 100% no-repeat,
      #1a428a;
  }
  .short {
    display: none;
  }
  @media (max-width: 760px) {
    .tools {
      display: none;
    }
    .long {
      display: none;
    }
    .short {
      display: inline;
    }
    .sign-nav {
      flex-wrap: nowrap;
      gap: 0;
      margin-top: 0.4rem;
    }
    .sign-nav a {
      padding: 0.7rem 0.7rem;
    }
    .bench {
      grid-template-columns: 1.15fr 1fr;
      grid-template-areas:
        "tape tape"
        "phone disp";
      padding-top: 1.5rem;
      gap: 1.25rem 0.75rem;
      align-items: center;
    }
    .tray,
    .work-order {
      display: none;
    }
    .phone {
      width: 100%;
      max-width: 200px;
    }
    .dispenser {
      justify-self: center;
    }
  }

  /* ---------- intake clipboard ---------- */
  .clipboard {
